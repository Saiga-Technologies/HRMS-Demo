{
  "name": "@hrms/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --no-warnings=ExperimentalWarning src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.1.1"
  }
}
